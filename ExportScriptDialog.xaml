<Window x:Class="KyFromAboveSTAC.ExportScriptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Script"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White">
    <!--
        Every text-bearing control below sets its own Foreground/Background explicitly.
        This dialog runs inside ArcGIS Pro's process, which defines its own app-wide implicit
        styles for common controls (aimed at Pro's own dark ribbon/dockpane chrome); without
        local overrides here, RadioButton labels rendered washed-out gray-on-white and TextBox
        rendered white-on-black, both unreadable against this dialog's plain white background.
    -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Foreground="Black" TextWrapping="Wrap" Margin="0,0,0,10">
            Write out a stand-alone download kit for the selected (or all) results that runs
            without ArcGIS Pro -- for very large batches, running on another machine, or
            scheduling for later.
        </TextBlock>

        <TextBlock Grid.Row="1" Text="Output type" FontWeight="SemiBold" Foreground="Black" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="2" x:Name="FormatCombo" Margin="0,0,0,2" Background="White" Foreground="Black"
                  SelectionChanged="FormatCombo_SelectionChanged">
            <ComboBoxItem Content="Executable (.exe)" Tag="Executable" Foreground="Black" IsSelected="True"/>
            <ComboBoxItem Content="Python script (.py)" Tag="Python" Foreground="Black"/>
            <ComboBoxItem Content="PowerShell script (.ps1)" Tag="PowerShell" Foreground="Black"/>
            <ComboBoxItem Content="Batch file (.bat)" Tag="Batch" Foreground="Black"/>
            <ComboBoxItem Content="Shell script (.sh)" Tag="Shell" Foreground="Black"/>
        </ComboBox>
        <TextBlock Grid.Row="3" x:Name="FormatHintText" Foreground="#555555" FontStyle="Italic" FontSize="11" Margin="0,2,0,10"/>

        <TextBlock Grid.Row="4" Text="Downloads will be saved to" FontWeight="SemiBold" Foreground="Black" Margin="0,0,0,2"/>
        <Grid Grid.Row="5" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="DestinationBox" Margin="0,0,4,0" VerticalContentAlignment="Center"
                      Background="White" Foreground="Black" BorderBrush="Gray" BorderThickness="1"/>
            <Button Grid.Column="1" Content="Browse..." Padding="8,2" Click="Browse_Click"/>
        </Grid>
        <TextBlock Grid.Row="6" TextWrapping="Wrap" Foreground="#555555" FontStyle="Italic" FontSize="11" Margin="0,0,0,8">
            The generated file is written into this same folder, alongside the downloads.
        </TextBlock>

        <TextBlock Grid.Row="7" x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Padding="10,4" Margin="0,0,6,0" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="Export" Padding="10,4" Click="Export_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
