<?xml version="1.0" encoding="utf-8" ?>
<!--
  KyFromAbove STAC Browser - ArcGIS Pro Add-in
  Searches and downloads data from the Kentucky From Above STAC API.
-->
<ArcGIS defaultAssembly="KyFromAboveAddin.dll" defaultNamespace="KyFromAbove"
        xmlns="http://schemas.esri.com/DADF/Registry"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Program%20Files/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd">
  <AddInInfo id="{8f3a2c1d-4b5e-4a6f-9c01-2d3e4f5a6b7c}" version="1.0.0.0" desktopVersion="3.7.0.1901" product="ArcGISPro">
    <Name>KyFromAbove STAC Browser</Name>
    <Description>Search and download aerial imagery, DEM, and LiDAR point cloud data from the Kentucky From Above STAC API.</Description>
    <Image>Images\AddInDesktop32.png</Image>
    <Author>KyFromAbove Tools</Author>
    <Company>KyFromAbove</Company>
    <Date>8/3/2026</Date>
    <Subject>Framework</Subject>
  </AddInInfo>
  <modules>
    <insertModule id="KyFromAbove_Module" className="Module1" autoLoad="true" caption="KyFromAbove">
      <tabs>
        <tab id="KyFromAbove_Tab1" caption="KyFromAbove" keytip="K0">
          <group refID="KyFromAbove_Group1" />
        </tab>
      </tabs>
      <groups>
        <group id="KyFromAbove_Group1" caption="STAC" appearsOnAddInTab="false" keytip="G1">
          <button refID="KyFromAbove_ShowSearchDockpane" size="large" />
        </group>
      </groups>
      <controls>
        <button id="KyFromAbove_ShowSearchDockpane" caption="STAC Search"
                className="ShowSearchDockpaneButton" loadOnClick="true" keytip="B1"
                smallImage="Images\AddInDesktop16.png" largeImage="Images\AddInDesktop32.png">
          <tooltip heading="STAC Search">
            Open the KyFromAbove STAC search pane to find and download imagery, DEM, and LiDAR data.<disabledText />
          </tooltip>
        </button>
        <tool id="KyFromAbove_DrawPointAoiTool" caption="Draw Point AOI" className="DrawPointAoiTool"
              loadOnClick="true" condition="esri_mapping_mapPane"
              smallImage="GenericPoint16" largeImage="GenericPoint32">
          <tooltip heading="Draw Point AOI">Draw a point to use as the STAC search 'intersects' AOI.<disabledText /></tooltip>
        </tool>
        <tool id="KyFromAbove_DrawLineAoiTool" caption="Draw Line AOI" className="DrawLineAoiTool"
              loadOnClick="true" condition="esri_mapping_mapPane"
              smallImage="GenericLine16" largeImage="GenericLine32">
          <tooltip heading="Draw Line AOI">Draw a line to use as the STAC search 'intersects' AOI.<disabledText /></tooltip>
        </tool>
        <tool id="KyFromAbove_DrawPolygonAoiTool" caption="Draw Polygon AOI" className="DrawPolygonAoiTool"
              loadOnClick="true" condition="esri_mapping_mapPane"
              smallImage="GenericPolygon16" largeImage="GenericPolygon32">
          <tooltip heading="Draw Polygon AOI">Draw a polygon to use as the STAC search 'intersects' AOI.<disabledText /></tooltip>
        </tool>
      </controls>
      <dockPanes>
        <dockPane id="KyFromAbove_SearchDockpane" caption="KyFromAbove STAC"
                  className="SearchDockpaneViewModel" dock="group" dockWith="esri_core_contentsDockPane"
                  width="420">
          <content className="SearchDockpaneView" />
          <tooltip heading="KyFromAbove STAC">Search and download Kentucky From Above data<disabledText /></tooltip>
        </dockPane>
      </dockPanes>
    </insertModule>
  </modules>
</ArcGIS>
