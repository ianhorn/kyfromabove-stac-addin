<Window x:Class="KyFromAboveSTAC.AddApiSourceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bring Your Own API"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10">
            Point this search UI at another STAC API. You can add it alongside the built-in
            KyFromAbove collections, or replace the current source list entirely.
        </TextBlock>

        <TextBlock Grid.Row="1" Text="Name" FontWeight="SemiBold" Margin="0,0,0,2"/>
        <TextBox Grid.Row="2" x:Name="NameBox" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="3" Text="STAC API base URL" FontWeight="SemiBold" Margin="0,0,0,2"/>
        <TextBox Grid.Row="4" x:Name="UrlBox" Margin="0,0,0,4"
                 ToolTip="e.g. https://vdo05uew72.execute-api.us-west-2.amazonaws.com"/>

        <TextBlock Grid.Row="5" x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Padding="10,4" Margin="0,0,6,0" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="Replace all sources" Padding="10,4" Margin="0,0,6,0" Click="Replace_Click"
                    ToolTip="Remove all current sources and search only this API."/>
            <Button Content="Add" Padding="10,4" Click="Add_Click" IsDefault="True"
                    ToolTip="Keep existing sources and add this one alongside them."/>
        </StackPanel>
    </Grid>
</Window>
