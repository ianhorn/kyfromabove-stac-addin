<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stand-alone downloader bundled into the add-in package (see the Content item in
    ..\..\KyFromAboveSTACAddin.csproj) and offered as the "Executable (.exe)" option in
    Export Script. Reads manifest.json (written alongside it by Export Script) and downloads
    every listed asset: no ArcGIS Pro, and (published self-contained/single-file, as the add-in
    bundles it) no .NET runtime install, required on the machine that runs it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KyFromAboveDownloader</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Publish settings for the bundled binary (docs and Export Script both expect a single
    portable win-x64 exe). Rebuild it with:
        dotnet publish -c Release -r win-x64 -o bin\publish-win-x64
    Trimming is safe here: JSON (de)serialization uses the source-generated
    ManifestJsonContext, not reflection, so nothing trims away.
  -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
  </PropertyGroup>

</Project>
