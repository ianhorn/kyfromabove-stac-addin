<UserControl x:Class="KyFromAboveSTAC.SearchDockpaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="420">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component/Themes/Default.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- API sources + Collections -->
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,4">
            <Border BorderBrush="#33000000" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,4">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="STAC API:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0"/>
                        <Button Content="Bring Your Own API..." Command="{Binding BringYourOwnApiCommand}" Padding="6,2"
                                ToolTip="Add another STAC API alongside the built-in catalog, or replace it entirely. Experimental -- may not work as expected with all STAC APIs."/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding ApiSources}" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#55000000" BorderThickness="1" Padding="4,1" Margin="0,0,4,2" Background="#11000000">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="11"/>
                                        <Button Content="x" Width="16" Height="16" Padding="0" Margin="4,0,0,0" FontSize="9"
                                                Command="{Binding Path=DataContext.RemoveApiSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Remove this API source"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Expander Header="Collections" IsExpanded="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="120"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="Load collections" Margin="0,2"
                            Command="{Binding LoadCollectionsCommand}" Padding="4,2" HorizontalAlignment="Left"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Collections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayLabel}" IsChecked="{Binding IsChecked}" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Expander>
        </StackPanel>

        <!-- AOI -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,4">
            <TextBlock Text="Area of interest" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <WrapPanel Orientation="Horizontal" Margin="0,0,0,2">
                <ToggleButton x:Name="DrawAoiButton" Content="Draw..." Padding="6,2" Margin="0,0,2,0"
                        ToolTip="Draw a point, line, or polygon AOI on the map."/>
                <Popup x:Name="DrawAoiPopup" PlacementTarget="{Binding ElementName=DrawAoiButton}"
                       IsOpen="{Binding IsChecked, ElementName=DrawAoiButton, Mode=TwoWay}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="2">
                        <StackPanel Orientation="Vertical">
                            <Button Content="Draw Point" Command="{Binding DrawPointAoiCommand}" Click="DrawAoiOption_Click"
                                    Padding="6,2" HorizontalContentAlignment="Left"/>
                            <Button Content="Draw Line" Command="{Binding DrawLineAoiCommand}" Click="DrawAoiOption_Click"
                                    Padding="6,2" HorizontalContentAlignment="Left"/>
                            <Button Content="Draw Polygon" Command="{Binding DrawPolygonAoiCommand}" Click="DrawAoiOption_Click"
                                    Padding="6,2" HorizontalContentAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </Popup>
                <Button Content="Use Extent" Command="{Binding UseExtentAoiCommand}" Padding="6,2" Margin="0,0,2,0"/>
                <Button Content="Browse for AOI..." Command="{Binding BrowseAoiFileCommand}" Padding="6,2" Margin="0,0,2,0"
                        ToolTip="Load an AOI from a .shp or .geojson/.json file. Works even if no map is open."/>
            </WrapPanel>
            <WrapPanel Orientation="Horizontal" Margin="0,2,0,2" Width="Auto">
                <TextBlock Text="Layer:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox ItemsSource="{Binding MapLayers}" DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedLayer}" MinWidth="160" Margin="0,0,2,0"/>
                <TextBlock Text="{Binding SelectedLayerName}" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.8"/>
                <Button Content="Refresh" Command="{Binding RefreshLayersCommand}" Padding="6,2" Margin="0,0,2,0"/>
                <Button Content="Use Layer" Command="{Binding UseLayerAoiCommand}" Padding="6,2" Margin="0,0,2,0"/>
                <CheckBox IsChecked="{Binding PreferSelectedFeatures}" VerticalAlignment="Center" Margin="2,0,0,0"
                          ToolTip="Use selected features"/>
            </WrapPanel>
            <WrapPanel Orientation="Horizontal" Margin="0,2,0,2">
                <Button Content="Mosaic All to Map" Command="{Binding MosaicAllCommand}" Padding="6,2" Margin="0,0,2,0" FontWeight="SemiBold"/>
                <CheckBox Content="Build overviews" IsChecked="{Binding BuildOverviews}" VerticalAlignment="Center" Margin="4,0,2,0"/>
                <Button Content="Clear AOI" Command="{Binding ClearAoiCommand}" Padding="6,2" Margin="0,0,2,0"/>
            </WrapPanel>
            <TextBlock Text="{Binding AoiText}" TextTrimming="CharacterEllipsis" FontStyle="Italic" Opacity="0.8"/>
        </StackPanel>

        <!-- Date range (collapsed by default; filtering still applies if dates are set) -->
        <Expander Grid.Row="2" Header="Date range (optional)" IsExpanded="False" Margin="0,0,0,4">
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,4,0">
                    <TextBlock Text="Start date" Opacity="0.8"/>
                    <DatePicker SelectedDate="{Binding StartDate}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Vertical">
                    <TextBlock Text="End date" Opacity="0.8"/>
                    <DatePicker SelectedDate="{Binding EndDate}"/>
                </StackPanel>
            </Grid>
        </Expander>

        <!-- Search row -->
        <StackPanel Grid.Row="3" Margin="0,0,0,6">
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Limit" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding LimitOptions}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedLimitOption, Mode=TwoWay}" Width="90"
                          VerticalContentAlignment="Center"/>
                <TextBox Grid.Column="2" Text="{Binding Limit, UpdateSourceTrigger=PropertyChanged}" Width="55" Margin="4,0,0,0"
                         VerticalContentAlignment="Center" Visibility="{Binding IsCustomLimit, Converter={StaticResource BoolToVis}}"
                         ToolTip="Enter a custom result limit."/>
                <Button Grid.Column="4" Content="Search" Command="{Binding SearchCommand}" Padding="10,2" FontWeight="Bold"/>
            </Grid>
            <TextBlock Text="Thumbnail rendering is turned off to save network." FontStyle="Italic" FontSize="11" Opacity="0.8"
                       TextWrapping="Wrap" Visibility="{Binding ThumbnailsDisabled, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <!-- Results header + list -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding ResultsSummaryText}" FontWeight="SemiBold" Margin="0,0,0,4" Grid.Row="0"/>
            <Grid Margin="0,0,0,2" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="Select All" Command="{Binding ToggleSelectAllCommand}" Grid.Column="0" Padding="6,2" Margin="0,0,4,0" ToolTip="Toggle selection of all results for bulk actions."/>
                <Button Content="Download Selected" Command="{Binding DownloadAllCommand}" Grid.Column="1" HorizontalAlignment="Left" Padding="6,2" Margin="0,0,4,0" ToolTip="Prompts for a folder, then downloads selected assets there. Point-clouds (LAZ/LAS) are downloadable but cannot be added to the map." IsEnabled="{Binding HasSelection}"/>
                <Button Content="Show Footprints" Command="{Binding ShowFootprintsCommand}" Grid.Column="2" HorizontalAlignment="Right" Padding="6,2" ToolTip="Add result footprints as a layer to the active map."/>
            </Grid>
            <!-- Help text: clarify download vs add-to-map behavior for point-cloud assets -->
            <Grid Margin="0,4,0,6" Visibility="{Binding HasPointCloudResults, Converter={StaticResource BoolToVis}}" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Opacity="0.85" TextWrapping="Wrap" FontStyle="Italic" FontSize="12" HorizontalAlignment="Stretch">
                    Tip: Point-cloud assets (.laz, .las, etc.) cannot be added directly to the map from this UI, but you can select and download them for external processing.
                </TextBlock>
                <Button Grid.Column="1" Content="?" Command="{Binding ShowHelpCommand}" ToolTip="More about point-cloud downloads" Margin="8,0,0,0" Width="22" Height="22"/>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="3">
                <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#33000000" BorderThickness="0,0,0,1" Padding="4" Margin="2">
                            <Border.ToolTip>
                                <ToolTip MaxWidth="380">
                                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding DetailJson}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                                    </ScrollViewer>
                                </ToolTip>
                            </Border.ToolTip>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Image Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Width="60" Height="60" Stretch="Uniform"
                                       Source="{Binding ThumbnailLocalPath}" Margin="0,0,4,0"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,2"
                                          IsChecked="{Binding IsSelected}" ToolTip="Select for bulk download"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TitleText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CollectionTitle}" Opacity="0.8"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DateText}" Opacity="0.7"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Status}" Opacity="0.6" TextWrapping="Wrap"/>
                                <ProgressBar Grid.Row="4" Grid.Column="1" Height="6" Minimum="0" Maximum="100"
                                             Value="{Binding DownloadProgress}" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0"/>
                                <StackPanel Grid.Row="0" Grid.RowSpan="5" Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
                                    <Button Content="Add" Command="{Binding AddToMapCommand}" Margin="2" Padding="6,2" ToolTip="Adds raster assets to the active map. Point-clouds cannot be added; use Download."/>
                                    <Button Content="Download" Command="{Binding DownloadCommand}" Margin="2" Padding="6,2" ToolTip="Download this asset to disk. Supports raster and point-cloud assets (.tif, .laz, .las, etc.)."/>
                                    <Button Content="Zoom" Command="{Binding ZoomToCommand}" Margin="2" Padding="6,2"/>
                                    <Button Content="Footprint" Command="{Binding ShowFootprintCommand}" Margin="2" Padding="6,2"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

                <!-- Status bar -->
        <Grid Grid.Row="5" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <ProgressBar Width="120" Height="14" Margin="8,0,0,0" IsIndeterminate="True"
                             Visibility="{Binding IsSearchBusy, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Next page" Command="{Binding NextPageCommand}"
                        Padding="8,2" Margin="8,0,0,0"
                        Visibility="{Binding HasNextPage, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                <ToggleButton x:Name="ParallelDownloadsButton" Content="Parallel Downloads..." Padding="6,2"
                        ToolTip="Select number of parallel downloads (cores/threads). Default: 75%."/>
                <Popup x:Name="ParallelDownloadsPopup" PlacementTarget="{Binding ElementName=ParallelDownloadsButton}"
                       IsOpen="{Binding IsChecked, ElementName=ParallelDownloadsButton, Mode=TwoWay}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="2">
                        <ListBox ItemsSource="{Binding ThreadOptions}" DisplayMemberPath="Label"
                                 SelectedItem="{Binding SelectedThreadOption, Mode=TwoWay}"
                                 SelectionChanged="ParallelDownloadsList_SelectionChanged"/>
                    </Border>
                </Popup>
                <TextBox Text="{Binding DownloadConcurrency, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="4,0,0,0"
                          VerticalContentAlignment="Center" Visibility="{Binding IsCustomThreadCount, Converter={StaticResource BoolToVis}}"
                          ToolTip="Enter a custom number of parallel downloads."/>
                <CheckBox IsChecked="{Binding DownloadPerItemFolder}" VerticalAlignment="Center" Margin="12,0,0,0"
                          ToolTip="Download each item into its own subfolder">
                    <TextBlock Text="Item folders" Margin="4,0,0,0" VerticalAlignment="Center"/>
                </CheckBox>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
