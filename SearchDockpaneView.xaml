<UserControl x:Class="KyFromAboveSTAC.SearchDockpaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="420">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component/Themes/Default.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- Read-only, selectable, link-capable text for the JSON hover card. Pro's implicit RichTextBox
                 template would restyle it, so this replaces the template with a plain one (same approach as the
                 TextBox style in ExportScriptDialog.xaml) so the colors below always apply. -->
            <Style x:Key="JsonRichTextBoxStyle" TargetType="RichTextBox">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#FF1E1E1E"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="6"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RichTextBox">
                            <Border Background="{TemplateBinding Background}">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Applied from code-behind only when Pro is in its Dark theme (see SearchDockpaneView.xaml.cs);
                 in any other theme the button keeps the default chrome, matching the panel's other buttons. -->
            <Style x:Key="DarkThemeButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FF3F3F46"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#FF6A6A6E"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}" CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#FF505058"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#FF2A2A2E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Whole-panel scrolling, so nothing is cut off when the pane is short. The results list keeps its own
         scrollbar; its height is capped in code-behind (FitResultsList) so it fills a tall pane but doesn't
         stretch to every result inside this ScrollViewer. -->
    <ScrollViewer x:Name="PanelScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="PanelGrid" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title + Help -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Kentucky outline (Census boundary, simplified) in blue with "STAC" over it; stands in for the "KyFromAbove-STAC"
                 title text. Vector, so it stays sharp at any DPI; colors are fixed and read on both light and dark panels. -->
            <Viewbox Grid.Column="0" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform"
                     ToolTip="KyFromAbove-STAC" AutomationProperties.Name="KyFromAbove-STAC">
                <Grid Width="100" Height="45">
                    <Path Fill="#FF2A6EBB" Data="M 91.5,15.3 L 91,17.2 L 93.3,19.8 L 92.9,20.6 L 95.6,24.8 L 98,27 L 100,27.3 L 94.9,31.9 L 89.9,34.7 L 89.9,35.7 L 87.9,36.9 L 87.3,38.6 L 85.2,39 L 84.3,40.8 L 79.1,42.2 L 76.9,43.6 L 39.6,42.4 L 21,42.7 L 21,42.2 L 18.1,42 L 18.3,45 L 0,45 L 0.7,42.9 L 2.4,43.8 L 3.3,42.4 L 2.9,40.9 L 3.9,40.1 L 3.2,39.3 L 4.2,37.4 L 3.2,35.7 L 4.4,33.7 L 6.4,32.6 L 12.9,35.2 L 13.3,33.9 L 12.1,31.7 L 12.6,29.9 L 18.2,28.2 L 16.9,25.2 L 18.7,22.9 L 20.3,22.8 L 20.3,20.8 L 21.3,21.6 L 23.4,21.2 L 23.8,22.5 L 24.5,21.9 L 24,20.7 L 24.6,19.9 L 25.6,21.1 L 27.3,20.6 L 31,23.2 L 32,21.1 L 34.8,19.5 L 37.4,22.1 L 38.9,18.8 L 41.7,17 L 43.5,19.3 L 46.5,19.4 L 48.2,14.8 L 50.1,14.5 L 51.1,12 L 53.6,10.5 L 53.5,7.1 L 55.6,6.9 L 57,7.8 L 59.4,6.3 L 61.8,5.9 L 62.2,4.5 L 60.7,1.5 L 62.6,0 L 64.4,1.3 L 66.9,0.9 L 68.6,2.4 L 69.9,5.8 L 74.5,6.6 L 77,8.8 L 79.2,7.6 L 82.4,9.3 L 84,9 L 85.7,7.2 L 87.6,6.6 L 88.3,9.5 L 90.2,10.3 L 91.6,12.3 L 91.5,15.3 Z"/>
                    <TextBlock Text="STAC" FontFamily="Segoe UI" FontWeight="ExtraBold" FontSize="18" Foreground="White"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,15,0,0"/>
                </Grid>
            </Viewbox>
            <Button Grid.Column="1" Content="Feedback" Command="{Binding FeedbackCommand}" Padding="8,2" Margin="0,0,6,0"
                    ToolTip="Report a bug, request a feature, or send feedback directly."/>
            <Button Grid.Column="2" Content="Help" Command="{Binding OpenDocsCommand}" Padding="8,2" Margin="0,0,6,0"
                    ToolTip="Open the full documentation site in your browser."/>
            <Button Grid.Column="3" Content="Check version" Command="{Binding CheckVersionCommand}" Padding="8,2"
                    ToolTip="Compare this build with the latest published release."/>
        </Grid>

        <!-- API sources + Collections -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,4">
            <Border BorderBrush="#33000000" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,4">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="STAC API:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0"/>
                        <Button Content="Bring Your Own API..." Command="{Binding BringYourOwnApiCommand}" Padding="6,2"
                                ToolTip="Add another STAC API alongside the built-in catalog, or replace it entirely. Experimental -- may not work as expected with all STAC APIs."/>
                        <Button Content="?" Command="{Binding OpenDocsCommand}" CommandParameter="collections-and-sources"
                                Width="18" Height="18" Padding="0" FontSize="10" Margin="4,0,0,0" Opacity="0.7"
                                ToolTip="Help: Collections &amp; Sources"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding ApiSources}" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#55000000" BorderThickness="1" Padding="4,1" Margin="0,0,4,2" Background="#11000000">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="11"/>
                                        <Button Content="x" Width="16" Height="16" Padding="0" Margin="4,0,0,0" FontSize="9"
                                                Command="{Binding Path=DataContext.RemoveApiSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Remove this API source"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="Collections" FontWeight="SemiBold"/>
                <Button Content="?" Command="{Binding OpenDocsCommand}" CommandParameter="collections-and-sources"
                        Width="18" Height="18" Padding="0" FontSize="10" Margin="4,0,0,0" Opacity="0.7"
                        ToolTip="Help: Collections &amp; Sources"/>
            </StackPanel>
            <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="120"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" x:Name="LoadCollectionsButton" Content="Load collections" Margin="0,2"
                            Command="{Binding LoadCollectionsCommand}" Padding="6,3" HorizontalAlignment="Left"/>
                    <ScrollViewer Grid.Row="1" x:Name="CollectionsScroll" VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="InnerScroll_PreviewMouseWheel">
                        <ItemsControl ItemsSource="{Binding Collections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayLabel}" IsChecked="{Binding IsChecked}" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
            </Grid>
        </StackPanel>

        <!-- AOI -->
        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="Area of interest" FontWeight="SemiBold"/>
                <Button Content="?" Command="{Binding OpenDocsCommand}" CommandParameter="area-of-interest"
                        Width="18" Height="18" Padding="0" FontSize="10" Margin="4,0,0,0" Opacity="0.7"
                        ToolTip="Help: Area of Interest"/>
            </StackPanel>
            <WrapPanel Orientation="Horizontal" Margin="0,0,0,2">
                <Button x:Name="DrawAoiButton" Content="Draw..." Click="DrawAoiButton_Click" Padding="6,2" Margin="0,0,2,0"
                        ToolTip="Draw a point, line, or polygon AOI on the map."/>
                <Popup x:Name="DrawAoiPopup" PlacementTarget="{Binding ElementName=DrawAoiButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="2">
                        <StackPanel Orientation="Vertical">
                            <Button Content="Draw Point" Command="{Binding DrawPointAoiCommand}" Click="DrawAoiOption_Click"
                                    Padding="6,2" HorizontalContentAlignment="Left"/>
                            <Button Content="Draw Line" Command="{Binding DrawLineAoiCommand}" Click="DrawAoiOption_Click"
                                    Padding="6,2" HorizontalContentAlignment="Left"/>
                            <Button Content="Draw Polygon" Command="{Binding DrawPolygonAoiCommand}" Click="DrawAoiOption_Click"
                                    Padding="6,2" HorizontalContentAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </Popup>
                <Button Content="Use Extent" Command="{Binding UseExtentAoiCommand}" Padding="6,2" Margin="0,0,2,0"/>
                <Button Content="Browse for AOI..." Command="{Binding BrowseAoiFileCommand}" Padding="6,2" Margin="0,0,2,0"
                        ToolTip="Load an AOI from a .shp or .geojson/.json file. Works even if no map is open."/>
                <Button Content="Select Features" Command="{Binding SelectFeatureAoiCommand}" Padding="6,2" Margin="0,0,2,0"
                        ToolTip="Click (or drag a box over) existing map features to use their combined geometry as the STAC search 'intersects' AOI."/>
            </WrapPanel>
            <WrapPanel Orientation="Horizontal" Margin="0,2,0,2" Width="Auto">
                <TextBlock Text="Map Layer:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox ItemsSource="{Binding MapLayers}" DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedLayer}" MinWidth="160" Margin="0,0,2,0"/>
                <TextBlock Text="{Binding SelectedLayerName}" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.8"/>
                <Button Content="Refresh" Command="{Binding RefreshLayersCommand}" Padding="6,2" Margin="0,0,2,0"/>
                <Button Content="Use Layer" Command="{Binding UseLayerAoiCommand}" Padding="6,2" Margin="0,0,2,0"/>
                <CheckBox IsChecked="{Binding PreferSelectedFeatures}" VerticalAlignment="Center" Margin="2,0,0,0"
                          ToolTip="Use selected features"/>
            </WrapPanel>
            <WrapPanel Orientation="Horizontal" Margin="0,2,0,2">
                <Button Content="Mosaic All to Map" Command="{Binding MosaicAllCommand}" Padding="6,2" Margin="0,0,2,0" FontWeight="SemiBold"
                        ToolTip="Builds a mosaic dataset from the selected (or all) raster results and adds it to the map. Disabled above 100 tiles -- narrow your search or select fewer tiles first."/>
                <CheckBox Content="Build overviews" IsChecked="{Binding BuildOverviews}" VerticalAlignment="Center" Margin="4,0,2,0"/>
                <Button Content="Clear AOI" Command="{Binding ClearAoiCommand}" Padding="6,2" Margin="0,0,2,0"/>
            </WrapPanel>
            <TextBlock Text="{Binding AoiText}" TextTrimming="CharacterEllipsis" FontStyle="Italic" Opacity="0.8"/>
        </StackPanel>

        <!-- Date range (collapsed by default; filtering still applies if dates are set) -->
        <Expander Grid.Row="3" IsExpanded="False" Margin="0,0,0,4">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Date range (optional)" Foreground="White"/>
                    <Button Content="?" Command="{Binding OpenDocsCommand}" CommandParameter="search-and-results"
                            Width="18" Height="18" Padding="0" FontSize="10" Margin="4,0,0,0" Opacity="0.7"
                            ToolTip="Help: Search &amp; Results"/>
                </StackPanel>
            </Expander.Header>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,4,0">
                    <TextBlock Text="Start date" Opacity="0.8"/>
                    <DatePicker SelectedDate="{Binding StartDate}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Vertical">
                    <TextBlock Text="End date" Opacity="0.8"/>
                    <DatePicker SelectedDate="{Binding EndDate}"/>
                </StackPanel>
            </Grid>
        </Expander>

        <!-- Search row -->
        <StackPanel Grid.Row="4" Margin="0,0,0,6">
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Limit" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding LimitOptions}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedLimitOption, Mode=TwoWay}" Width="90"
                          VerticalContentAlignment="Center"/>
                <TextBox Grid.Column="2" Text="{Binding Limit, UpdateSourceTrigger=PropertyChanged}" Width="55" Margin="4,0,0,0"
                         VerticalContentAlignment="Center" Visibility="{Binding IsCustomLimit, Converter={StaticResource BoolToVis}}"
                         ToolTip="Enter a custom result limit."/>
                <Button Grid.Column="4" Content="Search" Command="{Binding SearchCommand}" Padding="10,2" FontWeight="Bold"/>
            </Grid>
            <TextBlock Text="Thumbnail rendering is turned off to save network." FontStyle="Italic" FontSize="11" Opacity="0.8"
                       TextWrapping="Wrap" Visibility="{Binding ThumbnailsDisabled, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <!-- Results header + list -->
        <Grid x:Name="ResultsGrid" Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ResultsSummaryText}" FontWeight="SemiBold"/>
                <Button Grid.Column="1" Content="?" Command="{Binding OpenDocsCommand}" CommandParameter="downloads"
                        Width="18" Height="18" Padding="0" FontSize="10" Margin="4,0,0,0" Opacity="0.7"
                        ToolTip="Help: Downloads"/>
            </Grid>
            <Grid Margin="0,0,0,2" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="Select All" Command="{Binding ToggleSelectAllCommand}" Grid.Column="0" Padding="6,2" Margin="0,0,4,0" ToolTip="Toggle selection of all results for bulk actions."/>
                <Button Content="Download Selected" Command="{Binding DownloadAllCommand}" Grid.Column="1" HorizontalAlignment="Left" Padding="6,2" Margin="0,0,4,0" ToolTip="Prompts for a folder, then downloads selected assets there. Point-clouds (LAZ/LAS) are downloadable but cannot be added to the map." IsEnabled="{Binding HasSelection}"/>
                <Button Content="Export Script..." Command="{Binding ExportScriptCommand}" Grid.Column="2" Padding="6,2" Margin="0,0,4,0" ToolTip="Export a stand-alone download kit (executable, Python, PowerShell, or shell script) for the selected assets that runs without ArcGIS Pro -- useful for very large batches or running on another machine." IsEnabled="{Binding HasSelection}"/>
                <Button Content="Show Footprints" Command="{Binding ShowFootprintsCommand}" Grid.Column="3" HorizontalAlignment="Right" Padding="6,2" ToolTip="Add result footprints as a layer to the active map."/>
            </Grid>
            <!-- Help text: clarify download vs add-to-map behavior for point-cloud assets -->
            <Grid Margin="0,4,0,6" Visibility="{Binding HasPointCloudResults, Converter={StaticResource BoolToVis}}" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Opacity="0.85" TextWrapping="Wrap" FontStyle="Italic" FontSize="12" HorizontalAlignment="Stretch">
                    Point clouds can't be added to the map. Use View (COPC tiles) or Download. See ? for details.
                </TextBlock>
                <Button Grid.Column="1" Content="?" Command="{Binding ShowHelpCommand}" ToolTip="Help: viewing and downloading point clouds" Margin="8,0,0,0" Width="22" Height="22"/>
            </Grid>
            <ScrollViewer x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto" Grid.Row="3"
                          PreviewMouseWheel="InnerScroll_PreviewMouseWheel">
                <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#33000000" BorderThickness="0,0,0,1" Padding="4" Margin="2"
                                Background="Transparent"
                                MouseEnter="ResultRow_MouseEnter" MouseLeave="ResultRow_MouseLeave" Unloaded="ResultRow_Unloaded">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Image Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Width="60" Height="60" Stretch="Uniform"
                                       Source="{Binding ThumbnailLocalPath}" Margin="0,0,4,0"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,2"
                                          IsChecked="{Binding IsSelected}" ToolTip="Select for bulk download"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TitleText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CollectionTitle}" Opacity="0.8"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DateText}" Opacity="0.7"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Status}" Opacity="0.6" TextWrapping="Wrap"/>
                                <ProgressBar Grid.Row="4" Grid.Column="1" Height="6" Minimum="0" Maximum="100"
                                             Value="{Binding DownloadProgress}" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0"/>
                                <StackPanel Grid.Row="0" Grid.RowSpan="5" Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
                                    <Button Content="Add" Command="{Binding AddToMapCommand}" Margin="2" Padding="6,2" ToolTip="Adds raster assets to the active map. Point-clouds cannot be added; use Download."
                                            Visibility="{Binding CanAddToMap, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="View" Command="{Binding ViewInBrowserCommand}" Margin="2" Padding="6,2" ToolTip="Opens the KyFromAbove LiDAR Point Cloud Viewer in your web browser. Click the ? in the tip above the results for details."
                                            Visibility="{Binding IsCopc, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Download" Command="{Binding DownloadCommand}" Margin="2" Padding="6,2" ToolTip="Download this asset to disk. Supports raster and point-cloud assets (.tif, .laz, .las, etc.)."/>
                                    <Button Content="Zoom" Command="{Binding ZoomToCommand}" Margin="2" Padding="6,2"/>
                                    <Button Content="Footprint" Command="{Binding ShowFootprintCommand}" Margin="2" Padding="6,2"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Shared hover card for a result's raw JSON. Unlike a ToolTip it stays open while the mouse is
             over it (so its scrollbar works, text can be selected, and URLs are clickable); see ResultRow_MouseEnter. -->
        <Popup x:Name="JsonPopup" Placement="Right" HorizontalOffset="2" StaysOpen="True" AllowsTransparency="True">
            <Border x:Name="JsonCard" Background="White" BorderBrush="Gray" BorderThickness="1"
                    MouseEnter="JsonCard_MouseEnter" MouseLeave="JsonCard_MouseLeave">
                <RichTextBox x:Name="JsonText" Style="{StaticResource JsonRichTextBoxStyle}" Width="380" MaxHeight="360"
                             IsReadOnly="True" IsDocumentEnabled="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             LostMouseCapture="JsonText_LostMouseCapture"/>
            </Border>
        </Popup>
    </Grid>

                <!-- Status bar -->
        <Grid Grid.Row="6" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <ProgressBar Width="120" Height="14" Margin="8,0,0,0" IsIndeterminate="True"
                             Visibility="{Binding IsSearchBusy, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Next page" Command="{Binding NextPageCommand}"
                        Padding="8,2" Margin="8,0,0,0"
                        Visibility="{Binding HasNextPage, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="ParallelDownloadsButton" Content="Parallel Downloads..." Click="ParallelDownloadsButton_Click" Padding="6,2"
                        ToolTip="Select number of parallel downloads (cores/threads). Default: 75%."/>
                <Popup x:Name="ParallelDownloadsPopup" PlacementTarget="{Binding ElementName=ParallelDownloadsButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="2">
                        <ListBox ItemsSource="{Binding ThreadOptions}" DisplayMemberPath="Label"
                                 SelectedItem="{Binding SelectedThreadOption, Mode=TwoWay}"
                                 SelectionChanged="ParallelDownloadsList_SelectionChanged"/>
                    </Border>
                </Popup>
                <TextBox Text="{Binding DownloadConcurrency, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="4,0,0,0"
                          VerticalContentAlignment="Center" Visibility="{Binding IsCustomThreadCount, Converter={StaticResource BoolToVis}}"
                          ToolTip="Enter a custom number of parallel downloads."/>
                <CheckBox IsChecked="{Binding DownloadPerItemFolder}" VerticalAlignment="Center" Margin="12,0,0,0"
                          ToolTip="Download each item into its own subfolder">
                    <TextBlock Text="Item folders" Margin="4,0,0,0" VerticalAlignment="Center"/>
                </CheckBox>
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
