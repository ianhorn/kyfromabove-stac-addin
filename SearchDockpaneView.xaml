<UserControl x:Class="KyFromAbove.SearchDockpaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="420">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component/Themes/Default.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Collections -->
        <Expander Grid.Row="0" Header="Collections" IsExpanded="True" Margin="0,0,0,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="120"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Content="Load collections" Margin="0,2"
                        Command="{Binding LoadCollectionsCommand}" Padding="4,2" HorizontalAlignment="Left"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Collections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChecked}" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Expander>

        <!-- AOI -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,4">
            <TextBlock Text="Area of interest" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <WrapPanel Orientation="Horizontal" Margin="0,0,0,2">
                <Button Content="Draw Point" Command="{Binding DrawPointAoiCommand}" Padding="6,2" Margin="0,0,2,0"/>
                <Button Content="Draw Line" Command="{Binding DrawLineAoiCommand}" Padding="6,2" Margin="0,0,2,0"/>
                <Button Content="Draw Polygon" Command="{Binding DrawPolygonAoiCommand}" Padding="6,2" Margin="0,0,2,0"/>
            </WrapPanel>
            <WrapPanel Orientation="Horizontal" Margin="0,2,0,2" Width="Auto">
                <TextBlock Text="Layer:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox ItemsSource="{Binding MapLayers}" DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedLayer}" MinWidth="160" Margin="0,0,2,0"/>
                <Button Content="Refresh" Command="{Binding RefreshLayersCommand}" Padding="6,2" Margin="0,0,2,0"/>
                <Button Content="Use Layer" Command="{Binding UseLayerAoiCommand}" Padding="6,2" Margin="0,0,2,0"/>
            </WrapPanel>
            <WrapPanel Orientation="Horizontal" Margin="0,2,0,2">
                <Button Content="Mosaic All to Map" Command="{Binding MosaicAllCommand}" Padding="6,2" Margin="0,0,2,0" FontWeight="SemiBold"/>
                <CheckBox Content="Build overviews" IsChecked="{Binding BuildOverviews}" VerticalAlignment="Center" Margin="4,0,2,0"/>
                <Button Content="Clear AOI" Command="{Binding ClearAoiCommand}" Padding="6,2" Margin="0,0,2,0"/>
            </WrapPanel>
            <TextBlock Text="{Binding AoiText}" TextTrimming="CharacterEllipsis" FontStyle="Italic" Opacity="0.8"/>
        </StackPanel>

        <!-- Date range -->
        <Grid Grid.Row="2" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,4,0">
                <TextBlock Text="Start date" Opacity="0.8"/>
                <DatePicker SelectedDate="{Binding StartDate}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Vertical">
                <TextBlock Text="End date" Opacity="0.8"/>
                <DatePicker SelectedDate="{Binding EndDate}"/>
            </StackPanel>
        </Grid>

        <!-- Free text -->
        <TextBox Grid.Row="3" Text="{Binding FreeText, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,4" ToolTip="Search by item id / free text (optional)" />

        <!-- Search row -->
        <Grid Grid.Row="4" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Limit" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Grid.Column="1" Text="{Binding Limit, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" VerticalContentAlignment="Center"/>
            <Button Grid.Column="2" Content="Search" Command="{Binding SearchCommand}" Padding="10,2" FontWeight="Bold"/>
        </Grid>

        <!-- Results -->
        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#33000000" BorderThickness="0,0,0,1" Padding="4" Margin="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Image Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Width="60" Height="60" Stretch="Uniform"
                                       Source="{Binding ThumbnailUrl}" Margin="0,0,4,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TitleText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CollectionTitle}" Opacity="0.8"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DateText}" Opacity="0.7"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Status}" Opacity="0.6" TextWrapping="Wrap"/>
                                <ProgressBar Grid.Row="3" Grid.Column="1" Height="6" Minimum="0" Maximum="100"
                                             Value="{Binding DownloadProgress}" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0"/>
                                <StackPanel Grid.Row="0" Grid.RowSpan="4" Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
                                    <Button Content="Add" Command="{Binding AddToMapCommand}" Margin="2" Padding="6,2"/>
                                    <Button Content="Download" Command="{Binding DownloadCommand}" Margin="2" Padding="6,2"/>
                                    <Button Content="Zoom" Command="{Binding ZoomToCommand}" Margin="2" Padding="6,2"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Status bar -->
        <Grid Grid.Row="6" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <ProgressBar Width="120" Height="14" Margin="8,0,0,0" IsIndeterminate="True"
                             Visibility="{Binding IsSearchBusy, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Next page" Command="{Binding NextPageCommand}"
                    Padding="8,2" Visibility="{Binding HasNextPage, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Grid>
</UserControl>
